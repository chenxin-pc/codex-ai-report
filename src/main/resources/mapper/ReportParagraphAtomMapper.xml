<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aimilvusweb.repository.ReportParagraphAtomMapper">

    <resultMap id="ReportParagraphAtomResultMap" type="com.example.aimilvusweb.entity.ReportParagraphAtom">
        <id property="id" column="id"/>
        <result property="reportId" column="report_id"/>
        <result property="paragraphId" column="paragraph_id"/>
        <result property="pageNumber" column="page_number"/>
        <result property="sectionPath" column="section_path"/>
        <result property="paragraphText" column="paragraph_text"/>
        <result property="tokenCount" column="token_count"/>
        <result property="diagnostics" column="diagnostics"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.aimilvusweb.entity.ReportParagraphAtom" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO report_paragraph_atom(
            report_id,
            paragraph_id,
            page_number,
            section_path,
            paragraph_text,
            token_count,
            diagnostics,
            created_at
        )
        VALUES(
            #{reportId},
            #{paragraphId},
            #{pageNumber},
            #{sectionPath},
            #{paragraphText},
            #{tokenCount},
            #{diagnostics},
            #{createdAt}
        )
    </insert>

    <select id="selectByReportId" parameterType="long" resultMap="ReportParagraphAtomResultMap">
        SELECT id,
               report_id,
               paragraph_id,
               page_number,
               section_path,
               paragraph_text,
               token_count,
               diagnostics,
               created_at
        FROM report_paragraph_atom
        WHERE report_id = #{reportId}
        ORDER BY paragraph_id ASC
    </select>
</mapper>
