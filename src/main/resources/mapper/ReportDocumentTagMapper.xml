<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aimilvusweb.repository.ReportDocumentTagMapper">

    <resultMap id="ReportDocumentTagResultMap" type="com.example.aimilvusweb.entity.ReportDocumentTag">
        <id property="id" column="id"/>
        <result property="reportId" column="report_id"/>
        <result property="tagType" column="tag_type"/>
        <result property="tagCode" column="tag_code"/>
        <result property="tagName" column="tag_name"/>
        <result property="confidence" column="confidence"/>
        <result property="source" column="source"/>
        <result property="dictionaryVersion" column="dictionary_version"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.aimilvusweb.entity.ReportDocumentTag" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO report_document_tag(
            report_id,
            tag_type,
            tag_code,
            tag_name,
            confidence,
            source,
            dictionary_version,
            created_at,
            updated_at
        )
        VALUES(
            #{reportId},
            #{tagType},
            #{tagCode},
            #{tagName},
            #{confidence},
            #{source},
            #{dictionaryVersion},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <delete id="deleteByReportIdAndVersion">
        DELETE FROM report_document_tag
        WHERE report_id = #{reportId}
          AND dictionary_version = #{dictionaryVersion}
    </delete>

    <select id="selectByReportId" parameterType="long" resultMap="ReportDocumentTagResultMap">
        SELECT id,
               report_id,
               tag_type,
               tag_code,
               tag_name,
               confidence,
               source,
               dictionary_version,
               created_at,
               updated_at
        FROM report_document_tag
        WHERE report_id = #{reportId}
        ORDER BY tag_type ASC, confidence DESC, tag_code ASC
    </select>

    <select id="countByTagCodes" resultType="int">
        SELECT COUNT(1)
        FROM report_document_tag
        WHERE tag_type = #{tagType}
          AND tag_code IN
        <foreach collection="tagCodes" item="tagCode" open="(" separator="," close=")">
            #{tagCode}
        </foreach>
    </select>

</mapper>
