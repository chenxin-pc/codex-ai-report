<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aimilvusweb.repository.ReportChunkDiagnosticMapper">

    <resultMap id="ReportChunkDiagnosticResultMap" type="com.example.aimilvusweb.entity.ReportChunkDiagnostic">
        <id property="id" column="id"/>
        <result property="reportId" column="report_id"/>
        <result property="chunkUid" column="chunk_uid"/>
        <result property="parentChunkUid" column="parent_chunk_uid"/>
        <result property="parentIndex" column="parent_index"/>
        <result property="chunkIndexInParent" column="chunk_index_in_parent"/>
        <result property="chunkType" column="chunk_type"/>
        <result property="sectionPath" column="section_path"/>
        <result property="tokenCount" column="token_count"/>
        <result property="startParagraphId" column="start_paragraph_id"/>
        <result property="endParagraphId" column="end_paragraph_id"/>
        <result property="startPageNumber" column="start_page_number"/>
        <result property="endPageNumber" column="end_page_number"/>
        <result property="kept" column="kept"/>
        <result property="filterReason" column="filter_reason"/>
        <result property="diagnostics" column="diagnostics"/>
        <result property="chunkText" column="chunk_text"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.aimilvusweb.entity.ReportChunkDiagnostic" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO report_chunk_diagnostic(
            report_id,
            chunk_uid,
            parent_chunk_uid,
            parent_index,
            chunk_index_in_parent,
            chunk_type,
            section_path,
            token_count,
            start_paragraph_id,
            end_paragraph_id,
            start_page_number,
            end_page_number,
            kept,
            filter_reason,
            diagnostics,
            chunk_text,
            created_at
        )
        VALUES(
            #{reportId},
            #{chunkUid},
            #{parentChunkUid},
            #{parentIndex},
            #{chunkIndexInParent},
            #{chunkType},
            #{sectionPath},
            #{tokenCount},
            #{startParagraphId},
            #{endParagraphId},
            #{startPageNumber},
            #{endPageNumber},
            #{kept},
            #{filterReason},
            #{diagnostics},
            #{chunkText},
            #{createdAt}
        )
    </insert>

    <select id="selectByReportId" parameterType="long" resultMap="ReportChunkDiagnosticResultMap">
        SELECT id,
               report_id,
               chunk_uid,
               parent_chunk_uid,
               parent_index,
               chunk_index_in_parent,
               chunk_type,
               section_path,
               token_count,
               start_paragraph_id,
               end_paragraph_id,
               start_page_number,
               end_page_number,
               kept,
               filter_reason,
               diagnostics,
               chunk_text,
               created_at
        FROM report_chunk_diagnostic
        WHERE report_id = #{reportId}
        ORDER BY parent_index ASC, chunk_type DESC, chunk_index_in_parent ASC, id ASC
    </select>
</mapper>
