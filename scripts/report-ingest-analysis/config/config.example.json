{
  "input": {
    "mode": "local_dir",
    "limit": 10,
    "local_dir": "./reports",
    "url_manifest": "./reports/report_urls.csv",
    "eastmoney_manifest": "./reports/eastmoney_urls.csv",
    "eastmoney_manifest_url": "",
    "beginTime": "2026-05-01",
    "endTime": "2026-06-02",
    "pageSize": 50,
    "download_dir": "./outputs/downloads"
  },
  "api": {
    "base_url": "http://localhost:8080",
    "upload_path": "/api/reports/upload",
    "recommend_path": "/api/reports/recommend"
  },
  "database": {
    "mysql_command": "mysql",
    "mysql_container": "",
    "host": "localhost",
    "port": 3306,
    "database": "ai_report_rag",
    "username": "${MYSQL_USERNAME}",
    "password": "${MYSQL_PASSWORD}"
  },
  "output": {
    "dir": "./outputs/report-ingest-analysis",
    "max_text_length": 2000
  },
  "evaluation": {
    "queries": [
      "你好",
      "分析港口行业近期景气度",
      "分析000582",
      "北部湾港和医药证据混杂时如何处理？",
      "AI 算力产业链未来一年景气度如何？",
      "半导体设备国产替代有哪些投资机会？"
    ]
  },
  "runtime": {
    "continue_on_error": true
  }
}
